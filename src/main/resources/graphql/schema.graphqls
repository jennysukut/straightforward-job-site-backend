type Query {
  helloWorld: String
}

type Mutation {
  signupFellow(
      email: String!,
      password: String!,
      name: String!,
      isBetaTester: Boolean,
      isCollaborator: Boolean,
      message: String,
      referralCode: String,
      isReferralPartner: Boolean
    ): ID!

  signupBusiness(
      email: String!,
      password: String!,
      name: String!,
      isBetaTester: Boolean!,
      contactName: String!,
      isEarlySignup: Boolean,
      referral: String!
    ): ID!

  acceptFellowDonation(
      email: String!,
      password: String!,
      name: String!,
      isBetaTester: Boolean!,
      isCollaborator: Boolean!,
      message: String!,
      referralCode: String,
      isReferralPartner: Boolean!
      amount: String!,
      currency: String!,
      paymentType: String!
    ): ClientCheckoutData!

  acceptBusinessDonation(
      email: String!,
      password: String!,
      name: String!,
      isBetaTester: Boolean!,
      contactName: String!,
      isEarlySignup: Boolean,
      referral: String!,
      amount: String!,
      currency: String!,
      paymentType: String!
    ): ClientCheckoutData!

  generateResetPasswordToken(email: String!): String!

  resetPassword(email: String!, password: String!, token: String!): Boolean!

  login(email: String!, password: String!): Boolean!

  saveFellowProfilePage1(
    smallBio: String!,
    country: String!,
    location: String!,
    skills: [String!]!,
    jobTitles: [String!]!,
    languages: [String!]!
    ): Boolean!
}

scalar Long
scalar Url

type ClientCheckoutData {
  id: ID!,
  status: PaymentStatus!,
  checkoutToken: String!
}

enum PaymentStatus {
  APPROVED
  PENDING
}
